# 값은 따옴표와 줄 끝 주석 없이 이름=값으로 적는다 (docker run --env-file 은 따옴표를 값에 그대로 넣는다)
# 모델마다 주소 · 키가 다르다. 모델 하나 = 이름 · 주소 · 키 한 묶음이고, 다른 묶음의 주소 · 키를 빌려 쓰지 않는다

# 기본 모델 (6 luna). 지금 코드가 읽는 이름이라 그대로 둔다
OPENAI_BASE_URL=https://mlapi.run/2b112090-5609-4dde-87fb-161933470bde/v1
OPENAI_API_KEY=
OPENAI_MODEL=openai/gpt-6-luna

# sol (6.1 sol). 고성능 모델이 필요할 때만 쓴다. 쓰지 않을 때는 세 줄을 주석으로 둔다
# (AI 서비스는 묶음이 일부만 차 있으면 시작하지 않는다. 키만 비운 채 두면 시작 오류)
# OPENAI_SOL_BASE_URL=https://mlapi.run/0b127fbb-b979-4c1f-9962-64cffc3da42a/v1
# OPENAI_SOL_API_KEY=
# OPENAI_SOL_MODEL=openai/gpt-6.1-sol

# 비교용 묶음 — 대화 에이전트 연구 평가의 모델 비교(`chat_agent_lab.evals --bundle OPENAI_TERRA` · `--bundle OPENAI_HAIKU`)만 읽는다.
# AI 서비스는 읽지 않는다. 주소 · 키는 게이트웨이에서 그 모델 몫으로 받은 값을 넣는다. 쓰지 않을 때는 주석으로 둔다
# (sol 은 이 게이트웨이의 chat completions 에서 도구 호출이 되지 않아 대화 에이전트 비교에 쓸 수 없다)
# OPENAI_TERRA_BASE_URL=
# OPENAI_TERRA_API_KEY=
# OPENAI_TERRA_MODEL=openai/gpt-6.1-terra
# OPENAI_HAIKU_BASE_URL=
# OPENAI_HAIKU_API_KEY=
# OPENAI_HAIKU_MODEL=claude-haiku-5-5

# 임베딩 (text-embedding-3-small). 대화 에이전트의 자료 검색(키워드 + 의미 검색)에 쓴다
# 게이트웨이는 모델마다 주소 · 키가 달라 기본 묶음 주소로는 임베딩을 부를 수 없다. 임베딩용 주소 · 키를 따로 넣는다
# 쓰지 않을 때는 세 줄을 주석으로 둔다(그때는 키워드 검색만 한다)
# OPENAI_EMBEDDING_BASE_URL=
# OPENAI_EMBEDDING_API_KEY=
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# AI 서비스의 선택 변수. 기본값을 쓰면 주석 그대로 둔다 (빈 값을 넣으면 숫자 · 참거짓 변수는 읽을 때 오류)
# LLM 호출 한 번의 시간 제한(초)과 재시도 횟수
# LLM_TIMEOUT_SECONDS=12
# LLM_MAX_RETRIES=1
# 기능마다 다른 LLM 호출 시간 제한(초). 없으면 LLM_TIMEOUT_SECONDS 를 쓴다 (docs/ai/architecture.md 10절)
# 대본 전달도: 평가 기준 만들기 호출이 12초를 자주 넘어 잰 값으로 20초 (docs/ai/features/script-coverage-evaluation.md 8절).
SCRIPT_COVERAGE_LLM_TIMEOUT_SECONDS=20
# uvicorn 워커 수
# WEB_CONCURRENCY=1

# 대화 에이전트 /agent/turn (docs/ai/architecture.md 10절 · docs/ai/features/chat-agent.md 11-1)
# 끄기 스위치. 서버는 BE 쪽 스위치와 함께 켠다(기본 false: 대화 경로만 503 AGENT_DISABLED)
# AGENT_ENABLED=false
# 대화 동시 상한(AI 프로세스별), 대화 전용 실행 풀 = 이 값 × 2
# AGENT_MAX_CONCURRENCY=4
# 실행 상태 서명 키(비밀값, 32바이트 이상, 모든 워커 · 재시작에서 같은 값)와 바로 전 키(키를 바꿀 때만, 35분 이상)
AGENT_STATE_SECRET=
AGENT_STATE_SECRET_PREVIOUS=
