# 값은 따옴표와 줄 끝 주석 없이 이름=값으로 적는다 (docker run --env-file 은 따옴표를 값에 그대로 넣는다)
# 모델마다 주소 · 키가 다르다. 모델 하나 = 이름 · 주소 · 키 한 묶음이고, 다른 묶음의 주소 · 키를 빌려 쓰지 않는다

# 기본 모델 (6 luna). 지금 코드가 읽는 이름이라 그대로 둔다
OPENAI_BASE_URL=https://mlapi.run/2b112090-5609-4dde-87fb-161933470bde/v1
OPENAI_API_KEY=
OPENAI_MODEL=openai/gpt-6-luna

# sol (6.1 sol). 고성능 모델이 필요할 때만 쓴다. 쓰지 않을 때는 세 줄을 주석으로 둔다
# (AI 서비스는 묶음이 일부만 차 있으면 시작하지 않는다. 키만 비운 채 두면 시작 오류)
# OPENAI_SOL_BASE_URL=https://mlapi.run/0b127fbb-b979-4c1f-9962-64cffc3da42a/v1
# OPENAI_SOL_API_KEY=
# OPENAI_SOL_MODEL=openai/gpt-6.1-sol

# AI 서비스의 선택 변수. 기본값을 쓰면 주석 그대로 둔다 (빈 값을 넣으면 숫자 변수는 읽을 때 오류)
# LLM 호출 한 번의 시간 제한(초)과 재시도 횟수
# LLM_TIMEOUT_SECONDS=12
# LLM_MAX_RETRIES=1
# uvicorn 워커 수
# WEB_CONCURRENCY=1
# 규약 확인용 대역 POST /sample/judge. 로컬 확인 때만 true 로 켠다 (서버 AI_ENV 에는 넣지 않는다)
# AI_ENABLE_SAMPLE=false
