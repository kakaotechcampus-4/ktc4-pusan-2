{
  "name": "gaze-local-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Browser port of the gaze v1 head-pose engine, plus a local demo page. Shaped for the frontend GazeClassifier contract.",
  "scripts": {
    "assets": "node scripts/copy-assets.mjs",
    "dev": "npm run assets && vite",
    "build": "npm run assets && npm run typecheck && vite build",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.fe.json",
    "test": "vitest run",
    "smoke": "npm run assets && node scripts/smoke.mjs",
    "fixtures": "cd .. && \"./.venv/Scripts/python.exe\" web/scripts/export_config.py && \"./.venv/Scripts/python.exe\" web/scripts/make_fixtures.py",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "bench": "npm run assets && node scripts/bench.mjs"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "1.0.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.1",
    "prettier": "^3.9.9",
    "puppeteer-core": "^25.12.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=24"
  }
}
