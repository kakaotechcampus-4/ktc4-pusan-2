{
  "schema_version": "1.0",
  "id": "path-nc-criteria-noalt",
  "set": "eval",
  "group": "not_comparable",
  "split": "dev",
  "act": "should_not",
  "title": "평가 기준 버전이 다른 Take 4 뿐이고 같은 기준의 대안 Take 가 없다 — 비교 결론 없이 사실 문장만, 대안 도구 선택도 없다",
  "baseline_type": "compare",
  "fixtures": {
    "pitches": [
      {
        "preset": "sample",
        "take_overrides": {
          "t-4": {
            "standard_version": 2,
            "result": {
              "filler_per_min": 4.0,
              "filler_count": 16
            }
          },
          "t-5": {
            "result": {
              "filler_per_min": 1.5,
              "filler_count": 6
            }
          }
        },
        "drop_takes": [
          "t-3"
        ]
      }
    ],
    "conversation": {
      "scope_pitch_id": "p-1"
    }
  },
  "turns": [
    {
      "message": "Take 4랑 비교해서 Take 5는 군더더기 말이 줄었는지 알려 줘",
      "page_take_id": "t-5"
    }
  ],
  "expected": {
    "checks": [
      {
        "check_id": "no-conclusion",
        "observe": "answer",
        "grader": "regex",
        "compare": "absent",
        "expect": "(줄었|늘었|좋아졌|나빠졌|개선)"
      },
      {
        "check_id": "fact-sentence",
        "observe": "answer",
        "grader": "regex",
        "compare": "contains",
        "expect": "평가 기준 버전|비교할 수 없"
      },
      {
        "check_id": "compare-then-fact",
        "observe": "trajectory",
        "compare": "precedes",
        "expect": [
          "tool:compare_takes:*",
          "decision:NOT_COMPARABLE:*"
        ],
        "metric": "path"
      },
      {
        "check_id": "fact-shown",
        "observe": "trajectory",
        "compare": "in_order",
        "expect": [
          "decision:NOT_COMPARABLE:FACT_SHOWN:CODE",
          "claim:*"
        ],
        "metric": "replan"
      },
      {
        "check_id": "no-alt-target",
        "observe": "trajectory",
        "compare": "absent",
        "expect": [
          "decision:NOT_COMPARABLE:ALT_TOOL:LLM"
        ],
        "metric": "replan"
      },
      {
        "check_id": "fact-on-plan",
        "observe": "trajectory",
        "grader": "regex",
        "compare": "contains",
        "expect": "비교 불가[^\\n]*평가 기준 버전 다름",
        "metric": "replan"
      },
      {
        "check_id": "status",
        "observe": "answer",
        "compare": "equals",
        "expect": "DONE",
        "path": "status"
      }
    ]
  },
  "source": "path-nc-criteria"
}
