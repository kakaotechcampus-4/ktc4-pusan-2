 "split": "dev",
 "act": "should",
 "title": "앞 답이 확인해 준 '작게 말함'을 되받은 둘째 질문 — '확인 불가'로 앞 답과 어긋나지 않고, 할 일 단계가 겹치지 않으며 크게 말하는 법을 답한다",
 "baseline_type": "record",
 "fixtures": {
  "pitches": [
   {
    "preset": "sample"
   },
   {
    "pitch_id": "p-abc",
    "title": "abc",
    "last_practiced_at": "2026-11-10T21:00:00+09:00",
    "criteria": null,
    "takes": [
     {
      "take_id": "abc-t1",
      "take_number": 1,
      "completed_at": "2026-11-10T20:00:00+09:00",
      "result": {
       "voice_diff_db": -0.6
      }
     },
     {
      "take_id": "abc-t2",
      "take_number": 2,
      "completed_at": "2026-11-10T21:00:00+09:00",
      "result": {
       "voice_diff_db": -1.4,
       "issues": [
        [
         "VOLUME_LOW",
         3,
         true
        ]
       ]
      }
     }
    ]
   }
  ],
  "conversation": {
   "scope_pitch_id": null
  }
 },
 "turns": [
  {
   "message": "최근 발표에서 제 목소리 크기가 어땠나요?"
  },
  {
   "message": "목소리를 작게 말했다고 하는데 어떻게 하면 크게 말할 수 있을까요?"
  }
 ],
 "expected": {
  "checks": [
   {
    "check_id": "no-unverifiable-echo",
    "observe": "answer",
    "grader": "regex",
    "compare": "absent",
    "expect": "확인할 수 없어요|확인 불가",
