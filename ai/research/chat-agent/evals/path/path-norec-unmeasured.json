{
  "schema_version": "1.0",
  "id": "path-norec-unmeasured",
  "set": "eval",
  "group": "pitch_analysis",
  "split": "dev",
  "act": "should",
  "title": "Take 5 의 시선 영역이 측정 안 됨(값 null) — '문제 구간 없음'이 아니라 측정 안 됨으로 말한다",
  "baseline_type": "record",
  "fixtures": {
    "pitches": [
      {
        "preset": "sample",
        "take_overrides": {
          "t-5": {
            "result": {
              "unmeasured": {
                "GAZE": "LOW_MEASURED_RATIO"
              },
              "issues": []
            }
          }
        }
      }
    ],
    "conversation": {
      "scope_pitch_id": "p-1"
    }
  },
  "turns": [
    {
      "message": "Take 5 2장에서 시선 문제가 있던 구간이 어디야?",
      "page_take_id": "t-5"
    }
  ],
  "expected": {
    "checks": [
      {
        "check_id": "read-first",
        "observe": "trajectory",
        "compare": "in_order",
        "expect": [
          "tool:get_take_report:OK",
          "claim:*"
        ],
        "metric": "path"
      },
      {
