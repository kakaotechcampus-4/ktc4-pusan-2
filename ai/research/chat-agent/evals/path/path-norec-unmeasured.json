      },
      {
        "check_id": "no-none-claim",
        "observe": "answer",
        "compare": "absent",
        "expect": "문제 구간[^\\n]{0,10}없|문제없|구간이 없",
        "grader": "regex"
      },
      {
        "check_id": "status",
        "observe": "answer",
        "compare": "equals",
        "expect": "DONE",
        "path": "status"
