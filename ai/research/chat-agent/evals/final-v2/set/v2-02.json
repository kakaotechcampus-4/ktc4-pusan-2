      {
        "check_id": "goal-operator",
        "observe": "db_diff",
        "compare": "equals",
        "expect": "gt_base",
        "path": "after.conversation.goal.operator"
      },
      {
        "check_id": "goal-base-take",
        "observe": "db_diff",
        "compare": "equals",
