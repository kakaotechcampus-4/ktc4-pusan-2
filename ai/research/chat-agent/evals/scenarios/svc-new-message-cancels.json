{
  "schema_version": "1.0",
  "id": "svc-new-message-cancels",
  "set": "agent_service",
  "group": "approval",
  "split": "dev",
  "act": "should",
  "title": "목표 저장 확인을 기다리는 중 새 메시지 — 앞 확인은 취소 문장으로 끝나고 새 메시지에 답한다",
  "baseline_type": "goal",
  "fixtures": {
    "pitches": [
      {
        "preset": "sample"
      }
    ],
    "conversation": {
      "scope_pitch_id": "p-1"
    }
  },
  "turns": [
    {
      "message": "Take 5 기준으로 3장 청중 시선 비율을 높이는 걸 목표로 잡아 줘",
      "page_take_id": "t-5",
      "approval": "NEW_MESSAGE"
    },
    {
      "message": "아니다, Take 5 3장 청중 시선 비율이 몇 %였는지만 알려 줘",
      "page_take_id": "t-5"
    }
  ],
  "expected": {
    "checks": [
      {
        "check_id": "cancelled-sentence",
        "observe": "answer",
        "compare": "contains",
        "expect": "SystemText.APPROVAL_CANCELLED",
        "grader": "template",
        "turn": 0
      },
      {
        "check_id": "first-cancelled",
        "observe": "answer",
        "compare": "equals",
        "expect": "CANCELLED",
        "path": "status",
        "turn": 0
      },
      {
        "check_id": "no-save",
        "observe": "actions_executed",
        "compare": "absent",
        "expect": "SAVE_GOAL",
        "path": "types",
        "turn": "all"
      },
      {
        "check_id": "no-goal",
        "observe": "db_diff",
        "compare": "equals",
        "expect": null,
        "path": "after.conversation.goal"
      },
      {
        "check_id": "new-answer-value",
        "observe": "answer",
        "compare": "contains",
        "expect": "28%",
        "grader": "number",
        "derive": "t-5:GAZE.audience_ratio@3"
      },
      {
        "check_id": "status",
        "observe": "answer",
        "compare": "equals",
        "expect": "DONE",
        "path": "status"
      }
    ]
  }
}
