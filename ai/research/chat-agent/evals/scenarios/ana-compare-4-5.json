{
  "schema_version": "1.0",
  "id": "ana-compare-4-5",
  "set": "eval",
  "group": "pitch_analysis",
  "split": "dev",
  "act": "should",
  "title": "'Take 4보다 Take 5에서 3장 시선이 좋아졌어?' — Take 4 를 가져와 비교: 31% → 28%, 나빠졌어요(주장은 기록과 다름)",
  "expect_refusal": false,
  "baseline_type": "compare",
  "fixtures": {
    "pitches": [
      {
        "preset": "sample"
      }
    ],
    "conversation": {
      "scope_pitch_id": "p-1"
    }
  },
  "turns": [
    {
      "message": "Take 4보다 Take 5에서 3장 시선이 좋아졌어?",
      "page_take_id": "t-5"
    }
  ],
  "followups": [
    {
      "message": "Take 4 기록도 가져와서 3장 청중 시선 비율로 비교해 줘",
      "page_take_id": "t-5"
    }
  ],
  "expected": {
    "checks": [
      {
        "check_id": "fetch-take",
        "observe": "actions_executed",
        "compare": "contains",
        "expect": "FETCH_TAKE",
        "path": "types",
        "metric": "autonomy"
      },
      {
        "check_id": "previous",
        "observe": "answer",
        "compare": "contains",
        "expect": "31%",
        "grader": "number",
        "derive": "t-4:GAZE.audience_ratio@3"
      },
      {
        "check_id": "current",
        "observe": "answer",
        "compare": "contains",
        "expect": "28%",
        "grader": "number",
        "derive": "t-5:GAZE.audience_ratio@3"
      },
      {
        "check_id": "conclusion",
        "observe": "answer",
        "compare": "contains",
        "expect": "OUTCOME_WORD.WORSENED",
        "grader": "template"
      },
      {
        "check_id": "no-improved",
        "observe": "answer",
        "compare": "absent",
        "expect": "좋아졌어요",
        "grader": "regex"
      },
      {
        "check_id": "claim-contradicted",
        "observe": "answer",
        "compare": "contains",
        "expect": {
          "verdict": "CONTRADICTED"
        },
        "path": "assessments"
      },
      {
        "check_id": "status",
        "observe": "answer",
        "compare": "equals",
        "expect": "DONE",
        "path": "status"
      }
    ]
  }
}
