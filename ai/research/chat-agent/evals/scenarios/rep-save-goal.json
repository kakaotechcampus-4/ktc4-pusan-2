{
  "schema_version": "1.0",
  "id": "rep-save-goal",
  "set": "eval",
  "group": "representative",
  "split": "dev",
  "act": "should",
  "title": "대화 목표 저장: Take 5 기준 3장 청중 시선 비율(28%)을 높이기 — 저장 뒤 다시 읽은 값이 같다",
  "source": "rep-goal",
  "baseline_type": "goal",
  "fixtures": {
    "pitches": [
      {
        "preset": "sample"
      }
    ],
    "conversation": {
      "scope_pitch_id": "p-1"
    }
  },
  "turns": [
    {
      "message": "Take 5 기준으로 3장 청중 시선 비율을 높이는 걸 목표로 잡아 줘",
      "page_take_id": "t-5"
    }
  ],
  "expected": {
    "checks": [
      {
        "check_id": "save-executed",
        "observe": "actions_executed",
        "compare": "contains",
        "expect": "SAVE_GOAL",
        "path": "types",
        "metric": "autonomy",
        "turn": 0
      },
      {
        "check_id": "goal-metric",
        "observe": "db_diff",
        "compare": "equals",
        "expect": "audience_ratio",
        "path": "after.conversation.goal.metric",
        "turn": 0
      },
      {
        "check_id": "goal-slide",
        "observe": "db_diff",
        "compare": "equals",
        "expect": 3,
        "path": "after.conversation.goal.slide_number",
        "turn": 0
      },
      {
        "check_id": "goal-base-take",
        "observe": "db_diff",
        "compare": "equals",
        "expect": "t-5",
        "path": "after.conversation.goal.base.take_id",
        "turn": 0
      },
      {
        "check_id": "goal-base-value",
        "observe": "db_diff",
        "compare": "equals",
        "expect": 0.28,
        "path": "after.conversation.goal.base.value",
        "turn": 0,
        "derive": "t-5:GAZE.audience_ratio@3"
      },
      {
        "check_id": "goal-operator",
        "observe": "db_diff",
        "compare": "equals",
        "expect": "gt_base",
        "path": "after.conversation.goal.operator",
        "turn": 0
      },
      {
        "check_id": "goal-saved-card",
        "observe": "answer",
        "compare": "contains",
        "expect": "GOAL_SAVED",
        "path": "card_types"
      },
      {
        "check_id": "save-success-sentence",
        "observe": "answer",
        "compare": "contains",
        "expect": "ACTION_SUCCESS.SAVE_GOAL",
        "grader": "template"
      },
      {
        "check_id": "status",
        "observe": "answer",
        "compare": "equals",
        "expect": "DONE",
        "path": "status"
      }
    ]
  }
}
