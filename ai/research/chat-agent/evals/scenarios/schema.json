          },
          "minItems": 1,
          "title": "Checks",
          "type": "array"
        }
      },
      "required": [
        "checks"
      ],
      "title": "Expected",
      "type": "object"
    },
    "Fault": {
      "additionalProperties": false,
      "description": "차례 하나에 넣는 장애(10-5 '장애 주입').\n\n- model_delay: `after_call`번째 모델 호출이 끝난 뒤 시계를 `seconds`만큼 흘린다(모델이 오래 걸림 · 한도 끝)\n- model_error: `purpose`의 `nth`번째 호출을 보내지 않고 시간 초과로 끝낸다(`seconds`만큼 시계를 흘림)\n- corrupt_answer: 첫 답 쓰기 응답의 문장 속 `from_text`를 `to_text`로 바꾼다(답 검사가 숫자를 잡아 고치게 하는지)\n- delete_before_action: BE가 `action` 행동을 실행하기 직전에 `target` Take 를 지운다(행동 실패)\n- stream_cut: 그 차례에서 문장 줄을 `after_claims`개 처음 받은 AI 호출을 끝 줄 없이 끊는다(문장이 그보다 적은 호출은 그대로, 받은 문장으로 PARTIAL, L2-45)",
      "properties": {
        "kind": {
          "enum": [
            "model_delay",
            "model_error",
            "corrupt_answer",
            "delete_before_action",
            "stream_cut"
          ],
          "title": "Kind",
          "type": "string"
        },
        "after_call": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "After Call"
        },
        "after_claims": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "After Claims"
        },
        "seconds": {
          "default": 0.0,
          "minimum": 0,
          "title": "Seconds",
          "type": "number"
        },
        "purpose": {
          "anyOf": [
            {
              "enum": [
                "RESEARCH",
                "ANSWER",
                "FIX"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Purpose"
        },
        "nth": {
          "default": 1,
          "minimum": 1,
          "title": "Nth",
          "type": "integer"
        },
        "from_text": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "From Text"
        },
        "to_text": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "To Text"
        },
        "action": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Action"
        },
        "target": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target"
        }
      },
      "required": [
        "kind"
      ],
      "title": "Fault",
      "type": "object"
    },
