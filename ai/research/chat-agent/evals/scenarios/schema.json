    "CorpusSpec": {
      "additionalProperties": false,
      "description": "자료 묶음 바꾸기(주입 경로 시험용). 판은 `corpus_version`, 해시는 다시 계산한다.",
      "properties": {
        "corpus_version": {
          "default": "guides-1-eval",
          "title": "Corpus Version",
          "type": "string"
        },
        "extra_cards": {
