            "fluency": "STRENGTH",
            "content_delivery": "NOT_EVALUABLE"
          },
          "criteria_results": []
        },
        "path": "cards[type=REASSESS_RESULT].before",
        "note": "규칙 칸 전체(점수 · 차원 · 사용자 기준 판정)를 규칙 리뷰 코드로 계산했다(test_scenarios 가 다시 계산)"
      },
      {
        "check_id": "after-rule-fields",
        "observe": "answer",
        "compare": "equals",
        "expect": {
          "score": 100,
          "dimensions": {
            "audience_gaze": "STRENGTH",
            "script_independence": "NOT_EVALUABLE",
            "pacing_rhythm": "STRENGTH",
            "vocal_delivery": "STRENGTH",
            "fluency": "STRENGTH",
            "content_delivery": "NOT_EVALUABLE"
          },
          "criteria_results": []
        },
        "path": "cards[type=REASSESS_RESULT].after",
        "note": "규칙 칸 전체(점수 · 차원 · 사용자 기준 판정)를 규칙 리뷰 코드로 계산했다(test_scenarios 가 다시 계산)"
      },
      {
        "check_id": "changed-fields",
        "observe": "answer",
        "compare": "equals",
        "expect": ["score", "dimensions.script_independence"],
        "path": "cards[type=REASSESS_RESULT].changed_fields"
      },
      {
        "check_id": "official-same-as-a",
        "observe": "answer",
        "compare": "equals",
        "expect": false,
        "path": "cards[type=REASSESS_RESULT].official_differs"
      },
      {
        "check_id": "official-unchanged",
        "observe": "db_diff",
        "compare": "equals",
        "expect": [],
        "path": "official_changed"
      },
      {
        "check_id": "reassess-success",
        "observe": "answer",
        "compare": "contains",
        "expect": "ACTION_SUCCESS.REASSESS",
        "grader": "template"
      },
      {
        "check_id": "script-fact",
        "observe": "answer",
        "compare": "contains",
        "expect": {
          "name": "SCRIPT_FACT",
          "fields": {
            "state": "꺼져"
          }
        },
        "grader": "template"
      },
      {
        "check_id": "score-rise-notice",
        "observe": "answer",
        "compare": "contains",
        "expect": "SystemText.SCRIPT_POINTS_REMOVED",
        "grader": "template",
        "note": "규칙 리뷰 점수 A 88 → B 100(대본 의존 차원이 판단 불가로 빠짐, 6-6)"
      },
      {
        "check_id": "status",
        "observe": "answer",
        "compare": "equals",
        "expect": "DONE",
