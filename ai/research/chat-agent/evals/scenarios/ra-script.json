{
  "schema_version": "1.0",
  "id": "ra-script",
  "set": "eval",
  "group": "reassess",
  "split": "dev",
  "act": "should",
  "title": "'대본 보고 한 발표였어' → 대본 사용 조건(script_used=true)으로 A · B 를 불러 바뀐 칸만, 공식 결과는 그대로",
  "source": "ra-script",
  "baseline_type": "reassess",
  "fixtures": {
    "pitches": [
      {
        "preset": "sample"
      }
    ],
    "conversation": {
      "scope_pitch_id": "p-1"
    },
    "official_reviews": "rule"
  },
  "turns": [
    {
      "message": "Take 5는 대본 보고 한 발표였어. 그 조건으로 다시 평가해 줘",
      "page_take_id": "t-5"
    }
  ],
  "expected": {
