        "metric": "autonomy"
      },
      {
        "check_id": "no-review-calls",
        "observe": "actions_executed",
        "compare": "equals",
        "expect": 0,
        "path": "review_calls"
      },
      {
        "check_id": "measurement-fixed",
        "observe": "answer",
        "compare": "contains",
        "expect": "SystemText.MEASUREMENT_FIXED",
        "grader": "template"
      },
      {
        "check_id": "official-unchanged",
        "observe": "db_diff",
        "compare": "equals",
        "expect": [],
        "path": "official_changed"
      },
      {
        "check_id": "status",
        "observe": "answer",
        "compare": "equals",
        "expect": "DONE",
        "path": "status"
