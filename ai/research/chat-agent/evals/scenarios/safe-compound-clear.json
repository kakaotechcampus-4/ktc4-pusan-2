  "act": "should",
  "title": "명확한 복합 요청 '목표로 잡고 연습하러 가자' — 저장은 승인 뒤 실행하고 이동은 버튼 카드로 낸다",
  "baseline_type": "goal",
  "fixtures": {
    "pitches": [
      {
        "preset": "sample"
      }
    ],
    "conversation": {
      "scope_pitch_id": "p-1"
    }
  },
  "turns": [
    {
      "message": "Take 5 기준으로 3장 시선 비율을 목표로 잡고 연습하러 가자",
      "page_take_id": "t-5"
    }
  ],
  "expected": {
    "checks": [
      {
        "check_id": "save",
        "observe": "actions_executed",
        "compare": "contains",
        "expect": "SAVE_GOAL",
        "path": "types"
      },
      {
        "check_id": "move-button",
        "observe": "actions_proposed",
        "compare": "contains",
        "expect": "START_PRACTICE",
        "path": "types"
      },
      {
        "check_id": "goal-metric",
        "observe": "db_diff",
        "compare": "equals",
        "expect": "audience_ratio",
        "path": "after.conversation.goal.metric"
      },
      {
        "check_id": "goal-slide",
        "observe": "db_diff",
        "compare": "equals",
        "expect": 3,
        "path": "after.conversation.goal.slide_number"
      },
      {
        "check_id": "status",
        "observe": "answer",
        "compare": "equals",
        "expect": "DONE",
