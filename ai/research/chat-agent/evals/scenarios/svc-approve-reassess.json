{
  "schema_version": "1.0",
  "id": "svc-approve-reassess",
  "set": "agent_service",
  "group": "approval",
  "split": "dev",
  "act": "should",
  "title": "다시 평가 요청 — 승인 확인 카드(ASK) → 승인 뒤 저장한 인자로 한 번 실행",
  "baseline_type": "reassess",
  "fixtures": {
    "pitches": [
      {
        "preset": "sample"
      }
    ],
    "conversation": {
      "scope_pitch_id": "p-1"
    },
    "official_reviews": "rule"
  },
  "turns": [
    {
      "message": "Take 5는 대본 보고 한 발표였어. 그 조건으로 다시 평가해 줘",
      "page_take_id": "t-5"
    }
  ],
  "expected": {
    "checks": [
      {
        "check_id": "ask-grade",
        "observe": "actions_proposed",
        "compare": "equals",
        "expect": "ASK",
        "path": "items[type=REASSESS].autonomy"
      },
      {
        "check_id": "confirm-card",
        "observe": "actions_proposed",
        "compare": "contains",
        "expect": "ASK_CONFIRM",
        "path": "cards"
      },
      {
        "check_id": "one-reassess",
        "observe": "actions_executed",
        "compare": "equals",
        "expect": 1,
        "path": "counts.REASSESS"
      },
      {
        "check_id": "result-card",
        "observe": "answer",
        "compare": "contains",
        "expect": "REASSESS_RESULT",
        "path": "card_types"
      },
      {
        "check_id": "official-kept",
        "observe": "db_diff",
        "compare": "equals",
        "expect": [],
        "path": "official_changed"
      },
      {
        "check_id": "status",
        "observe": "answer",
        "compare": "equals",
        "expect": "DONE",
        "path": "status"
      }
    ]
  },
  "notes": "승인 전 실행 0번 · 승인한 해시와 같은 인자는 금지된 일(승인 없는 실행)로 따로 센다"
}
