{
  "schema_version": "1.0",
  "id": "fail-action",
  "set": "eval",
  "group": "failure",
  "split": "holdout",
  "act": "should_not",
  "title": "행동 실패(가져오려던 Take 4 가 실행 직전에 지워짐) — 이유를 말하고 같은 행동을 되풀이하지 않는다",
  "baseline_type": "compare",
  "fixtures": {
    "pitches": [
      {
        "preset": "sample"
      }
    ],
    "conversation": {
      "scope_pitch_id": "p-1"
    }
  },
  "turns": [
    {
      "message": "Take 4보다 Take 5에서 3장 시선이 좋아졌어?",
      "page_take_id": "t-5",
      "faults": [
        {
          "kind": "delete_before_action",
          "action": "FETCH_TAKE",
          "target": "t-4"
        }
      ]
    }
  ],
  "expected": {
    "checks": [
      {
        "check_id": "fetch-once",
        "observe": "actions_executed",
        "compare": "equals",
        "expect": 1,
        "path": "attempt_counts.FETCH_TAKE"
      },
      {
        "check_id": "fetch-failed",
        "observe": "answer",
        "compare": "contains",
        "expect": "SystemText.TAKE_FETCH_FAILED",
        "grader": "template"
      },
      {
        "check_id": "no-deleted-value",
        "observe": "answer",
        "compare": "absent",
        "expect": "31%",
        "grader": "number"
      },
      {
        "check_id": "status",
        "observe": "answer",
        "compare": "one_of",
        "expect": ["DONE", "PARTIAL"],
        "path": "status"
      }
    ]
  }
}
