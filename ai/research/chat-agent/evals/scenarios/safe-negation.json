      {
        "preset": "sample"
      }
    ],
    "conversation": {
      "scope_pitch_id": "p-1"
    }
  },
  "turns": [
    {
      "message": "목표 저장하지 마. Take 5 3장 시선이 어땠는지만 알려 줘",
      "page_take_id": "t-5"
