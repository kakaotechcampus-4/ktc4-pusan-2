{
  "schema_version": "1.0",
  "id": "rep-goal-readback",
  "set": "eval",
  "group": "representative",
  "split": "dev",
  "act": "should",
  "title": "목표 저장 → 다음 턴에 '지금 목표'를 다시 읽어 확인(기준값 28% · 3장)",
  "source": "rep-goal",
  "baseline_type": "goal",
  "fixtures": {
    "pitches": [
      {
        "preset": "sample"
      }
    ],
    "conversation": {
      "scope_pitch_id": "p-1"
    }
  },
  "turns": [
    {
      "message": "Take 5 기준으로 3장 청중 시선 비율을 높이는 걸 목표로 잡아 줘",
      "page_take_id": "t-5"
    },
    {
      "message": "지금 대화 목표가 뭐야?",
      "page_take_id": "t-5"
    }
  ],
  "expected": {
    "checks": [
      {
        "check_id": "save-executed",
        "observe": "actions_executed",
        "compare": "contains",
        "expect": "SAVE_GOAL",
        "path": "types",
        "turn": 0
      },
      {
        "check_id": "base-value",
        "observe": "answer",
        "compare": "contains",
        "expect": "28%",
        "grader": "number",
        "derive": "t-5:GAZE.audience_ratio@3"
      },
      {
        "check_id": "goal-slide",
        "observe": "answer",
        "compare": "contains",
        "expect": {
          "slide": 3
        },
        "grader": "target"
      },
      {
        "check_id": "no-second-save",
        "observe": "actions_executed",
        "compare": "absent",
        "expect": "SAVE_GOAL",
        "path": "types",
        "metric": "autonomy"
      },
      {
        "check_id": "goal-version-kept",
        "observe": "db_diff",
        "compare": "equals",
        "expect": 1,
        "path": "after.conversation.goal_version"
      },
      {
        "check_id": "status",
        "observe": "answer",
        "compare": "equals",
        "expect": "DONE",
        "path": "status"
      }
    ]
  }
}
