      },
      {
        "check_id": "fixed-reply-path",
        "observe": "trajectory",
        "compare": "in_order",
        "expect": ["claim:SYSTEM", "final:DONE"],
        "metric": "path"
      },
      {
        "check_id": "no-research",
        "observe": "trajectory",
        "compare": "not_in_order",
        "expect": ["tool:*"],
        "metric": "path",
        "note": "가벼운 말은 조사 · 답 쓰기 없이 계획 뒤 고정 문장으로 끝낸다(6-1)"
