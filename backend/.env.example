DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/pitch_coach

JWT_SECRET_KEY=change-me

# Google Cloud Console > API 및 서비스 > 사용자 인증 정보 > OAuth 2.0 클라이언트 ID (웹 애플리케이션)
# 승인된 리다이렉트 URI 에 GOOGLE_REDIRECT_URI 와 문자 하나까지 같은 값을 등록해야 한다.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# 선택. 아래는 전부 코드에 기본값이 있다. 바꿀 때만 주석 해제
# REDIS_URL=redis://localhost:6379/0
# ACCESS_TOKEN_EXPIRE_MINUTES=15
# REFRESH_TOKEN_EXPIRE_DAYS=14
# GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback
# FRONTEND_BASE_URL=http://localhost:3000
# Safari 등에서 로컬 쿠키가 저장되지 않을 때만 false
# COOKIE_SECURE=true
