# 주석 처리한 키는 코드에 기본값이 있다. 바꿀 때만 주석 해제

# Database
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/pitch_coach
# 테스트 · dev 스크립트가 호스트에서 붙을 주소. DATABASE_URL 이 컨테이너 안 주소(db:5432)일 때만 쓴다
# LOCAL_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/pitch_coach
# DB 잠금 · 문장 대기 상한(ms). 넘으면 일시 오류로 끝난다
# DB_LOCK_TIMEOUT_MS=5000
# DB_STATEMENT_TIMEOUT_MS=30000

# 32바이트보다 짧으면 서버가 뜨지 않는다. openssl rand -hex 32 로 만든다
JWT_SECRET_KEY=change-me
# ACCESS_TOKEN_EXPIRE_MINUTES=15
# REFRESH_TOKEN_EXPIRE_DAYS=14

# compose 의 db 컨테이너 계정. DATABASE_URL 의 사용자 · 비밀번호 · DB 이름과 맞춘다
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=pitch_coach

# 운영 도메인에서는 그 주소로 바꾼다
# GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback
# FRONTEND_BASE_URL=http://localhost:3000

# 출시 시각. 이 시각 전에는 구글 로그인을 막는다. release 에만 넣고 dev · 로컬은 비워 둔다.
# 시간대(+09:00)를 꼭 붙인다. 없으면 서버가 뜨지 않는다
# LAUNCH_AT=2026-10-30T14:00:00+09:00

# Google OAuth2 credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# AWS S3. SSO 로 로그인해서 액세스 키는 따로 없다
S3_BUCKET_NAME=
# S3_REGION=ap-northeast-2
# AWS_PROFILE=

# Deepgram STT. 키가 여럿이면 쉼표로 잇는다(예: key1,key2).
# 앞에서부터 쓰고, 크레딧이 떨어지거나 틀린 키라 거절되면 다음 키로 넘어간다
DEEPGRAM_API_KEYS=
# 키가 하나면 이것만 넣어도 된다. 둘 다 있으면 이 키를 맨 앞에 쓴다
# DEEPGRAM_API_KEY=

# AI 서버 주소. 운영(compose)은 http://ai:8000
# AI_BASE_URL=http://localhost:8001

# 관리자 콘솔(/admin) 팀 공용 계정. 둘 중 하나라도 없으면 콘솔이 열리지 않는다.
# 영문 · 숫자 · 기호만 쓴다. 비밀번호는 12자 이상
# 서버는 compose 가 이 파일을 읽으며 $ 뒤를 변수로 바꾼다. 비밀번호에 $ 가 있으면 작은따옴표로 감싼다
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD='<비밀번호>'

# 앱 로그 레벨. DEBUG · INFO · WARNING · ERROR
# LOG_LEVEL=INFO
# Safari 등에서 로컬 쿠키가 저장되지 않을 때만 false
# COOKIE_SECURE=true
# Take 자동 종료. 최근 A초 말이 없고 직전 B초 중 C 이상이 말 없음이면, 또는 최대 시간이 지나면 끝낸다
# TAKE_SILENCE_END_SEC=120
# TAKE_SILENCE_WINDOW_SEC=300
# TAKE_SILENCE_RATIO=0.8
# TAKE_MAX_DURATION_SEC=3600
