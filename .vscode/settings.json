{
  // ═══════════════════════════════════════════════════════════════════════
  //  저장소 루트를 워크스페이스로 열었을 때 적용되는 설정
  //
  //  VS Code 는 **워크스페이스 루트의 .vscode/ 하나만** 읽습니다.
  //  그래서 루트를 열면 frontend/.vscode/settings.json 은 통째로 무시되고,
  //  한 사람만 포맷터가 달라 저장할 때마다 따옴표와 줄바꿈이 오갑니다.
  //  같은 설정을 루트 기준으로 한 벌 더 두는 이유가 그것입니다.
  //
  //  ★ frontend/ 를 열었을 때와 **같은 결과**를 내는 것이 목표입니다.
  //    다른 것은 경로 값뿐입니다 — 여기는 루트 기준, 저기는 frontend/ 기준.
  //    한쪽을 고치면 다른 쪽도 같이 보세요.
  //
  //  ★ 포맷터 지정은 전부 언어 블록 안에 둡니다. 전역 editor.formatOnSave 를
  //    루트에 두면 backend(Python) 파일까지 Prettier 가 손대려 듭니다.
  // ═══════════════════════════════════════════════════════════════════════

  "[typescript]": {
    "editor.formatOnSave": true,
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.codeActionsOnSave": { "source.fixAll.oxc": "explicit" }
  },
  "[typescriptreact]": {
    "editor.formatOnSave": true,
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.codeActionsOnSave": { "source.fixAll.oxc": "explicit" }
  },
  "[javascript]": {
    "editor.formatOnSave": true,
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.codeActionsOnSave": { "source.fixAll.oxc": "explicit" }
  },
  "[json]": {
    "editor.formatOnSave": true,
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[jsonc]": {
    "editor.formatOnSave": true,
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[css]": {
    "editor.formatOnSave": true,
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[html]": {
    "editor.formatOnSave": true,
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[markdown]": {
    "editor.formatOnSave": true,
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },

  // 설정 파일이 없는 곳에서 Prettier 가 멋대로 돌지 않게 합니다.
  // backend·ai 에는 .prettierrc 가 없어서, 그쪽 파일은 이 규칙만으로도 안 건드립니다.
  "prettier.requireConfig": true,

  // ★ 무시 규칙을 루트에서도 살립니다.
  //
  //   Prettier 확장은 .prettierignore 를 **워크스페이스 루트**에서 찾습니다.
  //   가리켜 주지 않으면 src/index.css 와 Stage/stage.css 의 보호가 사라지는데,
  //   그 둘은 "정렬이 곧 주석"인 파일입니다 (계측 토큰 표·무대 레이아웃 설명).
  //
  //   패턴은 ignore 파일이 있는 폴더 기준으로 해석됩니다 — prettier.getFileInfo 로
  //   확인했습니다. 루트에서 열어도 index.css · stage.css · mockServiceWorker.js 는
  //   ignored=true 이고, src/main.tsx 는 정상적으로 포맷됩니다.
  "prettier.ignorePath": "frontend/.prettierignore",

  // oxlint 설정도 같은 이유로 가리킵니다. 없으면 확장이 기본 규칙으로 돌아서
  // 저장할 때마다 사람마다 다른 자동 수정이 들어갑니다.
  "oxc.configPath": "frontend/.oxlintrc.json",

  // 이 저장소는 oxlint 를 씁니다. ESLint 확장이 깔려 있으면 설정 파일이 없어서
  // "unable to resolve configuration" 잡음만 냅니다 (backend·ai 에 JS 가 없어 영향 없음).
  "eslint.enable": false,

  // 워크스페이스 TypeScript 를 쓰게 합니다. 최초 1회는 사람이 허용해야 합니다 (SETUP S5).
  // 빠뜨리면 한 사람 화면에만 빨간 줄이 뜨고 build 는 통과합니다.
  "typescript.tsdk": "frontend/node_modules/typescript/lib",
  "typescript.enablePromptUseWorkspaceTsdk": true,

  // Tailwind v4 는 설정이 CSS 안(@theme)에 있습니다. 지정하지 않으면
  // bg-greige 같은 토큰 유틸에 자동완성과 색 미리보기가 뜨지 않습니다.
  "tailwindCSS.experimental.configFile": "frontend/src/index.css",

  "files.eol": "\n",
  "files.insertFinalNewline": true,
  "files.trimTrailingWhitespace": true,

  "search.exclude": { "**/node_modules": true, "**/dist": true },

  // 탐색기 모양도 frontend/ 를 열었을 때와 같게 둡니다.
  // 파일은 원래 자리에 그대로 있고, 화살표를 펴면 다 나옵니다.
  "explorer.fileNesting.enabled": true,
  "explorer.fileNesting.expand": false,
  "explorer.fileNesting.patterns": {
    "package.json": ".gitattributes, .gitignore, .npmrc, .nvmrc, .oxlintrc.json, .prettierignore, .prettierrc, package-lock.json",
    "tsconfig.json": "tsconfig.*.json",
    ".env.example": ".env, .env.*",
    "README.md": "CLAUDE.md"
  },

  // 빌드 산출물만 감춥니다. node_modules 는 남겨 둡니다 —
  // 설치가 깨졌을 때 직접 들여다보는 게 원인 찾기의 첫 단계입니다.
  "files.exclude": { "frontend/dist": true }
}
