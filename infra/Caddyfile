{$SITE_URL} {
	# 관리자 콘솔. 화면 · 집계는 BE(backend/.../module/admin), 서버 로그는 Dozzle 이 보여 준다.
	# 로그인(브라우저 기본 로그인 창)은 BE 한 곳에서만 확인한다. 계정은 backend/.env 의 ADMIN_USERNAME · ADMIN_PASSWORD.
	# 끝에 / 가 없으면 여기서 붙인다. BE 가 붙이면 https 를 몰라 http 주소로 보낸다
	redir /admin /admin/

	# Dozzle 은 로그인이 없다. 넘기기 전에 BE 에 같은 계정인지 묻고, 아니면 BE 의 401 을 그대로 돌려준다
	handle /admin/logs* {
		forward_auth be:8000 {
			uri /admin/api/auth
		}
		reverse_proxy dozzle:8080
	}

	handle /admin/* {
		reverse_proxy be:8000
	}

	# 요청 본문 크기 상한. 넘으면 BE 에 닿기 전에 413 으로 끝낸다 (Caddy 2.7 전에는 502 였다).
	# 발표자료는 BE · FE 가 40MiB 까지 받는다. multipart 경계 · 헤더 몫으로 1MiB 를 더 둔다
	handle /api/pitches/add/*/presentation {
		request_body {
			max_size 41MiB
		}
		reverse_proxy be:8000
	}

	# 나머지 API 에서 가장 큰 본문은 대본이다 (5만 자, 150KB 남짓)
	handle /api/* {
		request_body {
			max_size 1MiB
		}
		reverse_proxy be:8000
	}

	handle {
		reverse_proxy fe:5173
	}
}
