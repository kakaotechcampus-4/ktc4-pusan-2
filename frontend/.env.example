# 복사해서 .env.local로 쓰세요. .env.local은 커밋되지 않습니다.
#   cp .env.example .env.local

# 목 서버를 끄고 실서버로 붙일 때 (W4 목요일)
VITE_USE_MOCK=true

# 목 상태로 로그인한 척 합니다. 세션이 필요한 화면을 BE 없이 열 때 켭니다.
# 로그인 화면 자체를 손볼 때는 꺼 두세요 (기본: 꺼짐)
VITE_MOCK_SESSION=false

# 실서버 주소. VITE_USE_MOCK=false일 때만 씁니다.
VITE_API_BASE=http://localhost:8000
